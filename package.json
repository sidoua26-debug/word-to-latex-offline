{
  "name": "word-to-latex-offline",
  "version": "1.0.0",
  "description": "Chrome extension to convert .docx and pasted content to LaTeX offline via pandoc-wasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test --test-concurrency=1 --experimental-strip-types tests/*.test.ts",
    "clean": "rm -rf dist word-to-latex-offline.zip",
    "package": "npm run build && (cd dist && zip -r ../word-to-latex-offline.zip .)"
  },
  "dependencies": {
    "pandoc-wasm": "*",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0"
  }
}
